{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cloverwoodstudio/codex-game-dev-library/tools/viewforge/manifest.schema.json",
  "title": "ViewForge manifest",
  "type": "object",
  "required": ["version", "name", "dimensions", "resolution", "views", "output_directory"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "units": { "enum": ["m", "cm", "mm"] },
    "dimensions": {
      "type": "object",
      "required": ["width", "depth", "height"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "depth": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "resolution": {
      "type": "object",
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "integer", "minimum": 2, "maximum": 256 },
        "y": { "type": "integer", "minimum": 2, "maximum": 256 },
        "z": { "type": "integer", "minimum": 2, "maximum": 256 }
      },
      "additionalProperties": false
    },
    "views": {
      "type": "object",
      "required": ["front", "side", "top"],
      "properties": {
        "front": { "$ref": "#/$defs/view" },
        "side": { "$ref": "#/$defs/view" },
        "top": { "$ref": "#/$defs/view" }
      },
      "additionalProperties": false
    },
    "output_directory": { "type": "string", "minLength": 1 },
    "bevel_width": { "type": "number", "minimum": 0 },
    "bevel_segments": { "type": "integer", "minimum": 1, "maximum": 8 },
    "render_size": { "type": "integer", "minimum": 128, "maximum": 4096 },
    "quality_gate": {
      "type": "object",
      "properties": {
        "minimum_iou": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "view": {
      "type": "object",
      "required": ["path", "mode"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["dark", "light", "alpha", "background"] },
        "threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "background_tolerance": { "type": "number", "minimum": 0, "maximum": 1 },
        "calibration": {
          "type": "object",
          "required": ["horizontal", "vertical"],
          "properties": {
            "horizontal": { "$ref": "#/$defs/calibrationAxis" },
            "vertical": { "$ref": "#/$defs/calibrationAxis" }
          },
          "additionalProperties": false
        },
        "perspective_rectification": {
          "type": "object",
          "required": ["corners", "horizontal", "vertical"],
          "properties": {
            "corners": {
              "type": "object",
              "required": ["top_left", "top_right", "bottom_right", "bottom_left"],
              "properties": {
                "top_left": { "$ref": "#/$defs/point" },
                "top_right": { "$ref": "#/$defs/point" },
                "bottom_right": { "$ref": "#/$defs/point" },
                "bottom_left": { "$ref": "#/$defs/point" }
              },
              "additionalProperties": false
            },
            "horizontal": { "$ref": "#/$defs/dimensionAxis" },
            "vertical": { "$ref": "#/$defs/dimensionAxis" }
          },
          "additionalProperties": false
        },
        "crop": {
          "type": "object",
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": { "type": "integer", "minimum": 0 },
            "y": { "type": "integer", "minimum": 0 },
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "flip_horizontal": { "type": "boolean" },
        "flip_vertical": { "type": "boolean" }
      },
      "allOf": [
        { "not": { "required": ["calibration", "perspective_rectification"] } }
      ],
      "additionalProperties": false
    },
    "calibrationAxis": {
      "type": "object",
      "required": ["dimension", "ledger_id", "pixel_min", "pixel_max"],
      "properties": {
        "dimension": { "enum": ["width", "depth", "height"] },
        "ledger_id": { "type": "string", "minLength": 1 },
        "pixel_min": { "type": "integer", "minimum": 0 },
        "pixel_max": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "dimensionAxis": {
      "type": "object",
      "required": ["dimension", "ledger_id"],
      "properties": {
        "dimension": { "enum": ["width", "depth", "height"] },
        "ledger_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "point": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
