    "top": { "path": "../crate/sheet.pgm", "crop": { "x": 24, "y": 0, "width": 12, "height": 12 }, "mode": "background", "background_tolerance": 0.1, "calibration": { "horizontal": { "dimension": "width", "ledger_id": "WRONG-WIDTH", "pixel_min": 26, "pixel_max": 33 }, "vertical": { "dimension": "depth", "ledger_id": "DIM-D", "pixel_min": 3, "pixel_max": 8 } } }
