{
  "$schema": "../../manifest.schema.json",
  "version": 1,
  "name": "calibration-crate",
  "units": "m",
  "dimensions": { "width": 2.0, "depth": 1.0, "height": 1.5 },
  "resolution": { "x": 24, "y": 16, "z": 20 },
  "views": {
    "front": { "path": "sheet.pgm", "crop": { "x": 0, "y": 0, "width": 12, "height": 12 }, "mode": "background", "background_tolerance": 0.1 },
    "side": { "path": "sheet.pgm", "crop": { "x": 12, "y": 0, "width": 12, "height": 12 }, "mode": "background", "background_tolerance": 0.1 },
    "top": { "path": "sheet.pgm", "crop": { "x": 24, "y": 0, "width": 12, "height": 12 }, "mode": "background", "background_tolerance": 0.1 }
  },
  "bevel_width": 0.03,
  "bevel_segments": 2,
  "render_size": 512,
  "quality_gate": { "minimum_iou": 0.99 },
  "output_directory": "output"
}
