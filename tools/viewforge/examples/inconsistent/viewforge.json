{
  "$schema": "../../manifest.schema.json",
  "version": 1,
  "name": "intentionally-inconsistent-crate",
  "units": "m",
  "dimensions": { "width": 2.0, "depth": 1.0, "height": 1.5 },
  "resolution": { "x": 24, "y": 16, "z": 20 },
  "views": {
    "front": { "path": "../crate/sheet.pgm", "crop": { "x": 0, "y": 0, "width": 12, "height": 12 }, "mode": "background", "background_tolerance": 0.1 },
    "side": { "path": "../crate/sheet.pgm", "crop": { "x": 12, "y": 0, "width": 12, "height": 12 }, "mode": "background", "background_tolerance": 0.1 },
    "top": { "path": "top-with-impossible-gap.pgm", "mode": "dark", "threshold": 0.5 }
  },
  "quality_gate": { "minimum_iou": 0.99 },
  "render_size": 128,
  "output_directory": "output"
}
